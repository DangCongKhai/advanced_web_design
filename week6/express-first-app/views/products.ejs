<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Danh sách sản phẩm</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main class="page">
    <header class="page-header">
      <h1>Danh sách sản phẩm</h1>
      <p>Chọn một sản phẩm để xem chi tiết.</p>
    </header>
    <div class="product-container">
      <section class="card">
      <ul class="product-list">
        <% products.forEach(p => { %>
          <li>
            <a class="product-item" href="/products/<%= p.id %>">
              <img class="product-thumb" src="<%= p.image %>" alt="<%= p.name %>">
              <span class="product-id">#<%= p.id %></span>
              <span class="product-name"><%= p.name %></span>
              <span class="product-price">$<%= p.price %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </section>

    <section class="card">
      <h2>Thêm sản phẩm</h2>
      <form class="product-form" action="/products" method="post">
        <label>
          Tên sản phẩm
          <input type="text" name="name" placeholder="Ví dụ: Laptop" required>
        </label>
        <label>
          Giá sản phẩm
          <input type="number" name="price" placeholder="Ví dụ: 1500" min="0" step="0.01" required>
        </label>
        <label>
          Ảnh sản phẩm (URL)
          <input type="url" name="image" placeholder="https://example.com/image.jpg" required>
        </label>
        <button type="submit">Thêm sản phẩm</button>
      </form>
    </section>
    </div>
    
  </main>
</body>
</html>

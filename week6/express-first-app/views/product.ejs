<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product ? product.name : 'Không tìm thấy sản phẩm' %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main class="page">
    <a class="back-link" href="/products">← Danh sách sản phẩm</a>

    <% if (product) { %>
      <section class="card product-detail">
        <img class="product-detail-image" src="<%= product.image %>" alt="<%= product.name %>">
        <p class="product-id">Sản phẩm #<%= product.id %></p>
        <h1><%= product.name %></h1>
        <p class="product-price">$<%= product.price %></p>
      </section>
    <% } else { %>
      <section class="card">
        <h1>Không tìm thấy sản phẩm</h1>
        <p>Sản phẩm này không tồn tại hoặc đã bị xóa.</p>
      </section>
    <% } %>
  </main>
</body>
</html>
